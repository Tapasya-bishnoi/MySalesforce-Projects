<aura:component
    implements="force:lightningQuickAction"
    access="global"
    controller="TaskGlobalActionController">

    <!-- IMPORTANT -->
    <aura:handler
        name="init"
        value="{!this}"
        action="{!c.doInit}"/>

    <aura:attribute
        name="recordTypeOptions"
        type="List"
        default="[]"/>

    <aura:attribute
        name="selectedRecordTypeId"
        type="String"/>

    <aura:attribute
        name="showTaskForm"
        type="Boolean"
        default="false"/>


    <!-- RECORD TYPE SCREEN -->

    <aura:if isTrue="{!not(v.showTaskForm)}">

        <div class="slds-p-around_medium">

            <h2 class="slds-text-heading_medium slds-m-bottom_medium">
                New Task
            </h2>

            <lightning:combobox
                name="recordType"
                label="Task Record Type"
                placeholder="Select Record Type"
                options="{!v.recordTypeOptions}"
                value="{!v.selectedRecordTypeId}"
                onchange="{!c.handleRecordTypeChange}"
                required="true"/>

            <div class="slds-m-top_medium">

                <lightning:button
                    variant="brand"
                    label="Next"
                    onclick="{!c.handleNext}"/>

            </div>

        </div>


        <!-- TASK FORM -->

        <aura:set attribute="else">

            <lightning:recordEditForm
                objectApiName="Task"
                recordTypeId="{!v.selectedRecordTypeId}"
                onsuccess="{!c.handleSuccess}"
                onerror="{!c.handleError}">

                <lightning:messages/>

                <div class="slds-p-around_medium">

                    <h2 class="slds-text-heading_medium slds-m-bottom_medium">
                        New Task
                    </h2>

                    <lightning:inputField
                        fieldName="OwnerId"/>

                    <lightning:inputField
                        fieldName="Subject"
                        required="true"/>

                    <lightning:inputField
                        fieldName="Type"/>

                    <lightning:inputField
                        fieldName="ActivityDate"/>

                    <lightning:inputField
                        fieldName="WhoId"/>

                    <lightning:inputField
                        fieldName="WhatId"/>

                    <lightning:inputField
                        fieldName="Status"/>

                    <lightning:inputField
                        fieldName="Priority"/>

                    <lightning:inputField
                        fieldName="Description"/>

                    <div class="slds-m-top_medium">

                        <lightning:button
                            type="submit"
                            variant="brand"
                            label="Save"/>

                    </div>

                </div>

            </lightning:recordEditForm>

        </aura:set>

    </aura:if>

</aura:component>